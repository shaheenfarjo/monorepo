{
  "name": "monorepo-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze": "turbo analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "check": "ultracite check",
    "check:placeholders": "bun scripts/check-placeholders.ts",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "gen:package": "turbo gen package",
    "init": "bun scripts/init.ts",
    "test": "turbo test",
    "test:template": "vitest run --dir scripts",
    "typecheck": "turbo typecheck"
  },
  "overrides": {
    "parse5": "^7.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@clack/prompts": "^1.1.0",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.14",
    "@types/node": "25.3.5",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3",
    "ultracite": "7.10.7",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22"
  }
}
